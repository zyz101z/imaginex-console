# Upstash Redis — shared leaderboard storage.
# Copy to .env.local and fill in values from your Upstash console.
# On Vercel, set these in Project Settings → Environment Variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Static Metered TURN pair (Metered dashboard → ICE servers). Rotated 2026-10-31; the old pair was in git history.
METERED_TURN_STATIC_USER=
METERED_TURN_STATIC_CRED=
